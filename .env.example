# Nagorik Desk environment. Copy to .env and fill in. Never commit the real .env.

# ── Required ──
# Postgres (Neon or local). Everything lives in the `nagorik_pg` schema.
DATABASE_URL=postgres://user:password@localhost:5432/nagorik
# 32-byte keys as 64 hex characters. Generate each with: openssl rand -hex 32
DATA_KEY=
HMAC_KEY=

# ── App ──
APP_URL=http://localhost:3000
NODE_ENV=development
TZ=Asia/Dhaka
LOG_LEVEL=info
# Bearer token for GET /api/cron/maintenance (daily housekeeping).
CRON_SECRET=

# ── Optional integrations (the UI says honestly when one is not configured) ──
# Email: password reset and email verification.
SMTP_URL=
SMTP_FROM="Nagorik Desk <no-reply@example.org>"
# Mobile verification (beta). Body template may use {to}, {text}, {sender}.
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_BODY=
SMS_API_KEY=
SMS_SENDER_ID=
# National ID verification is never collected until an authorised provider is configured.
NID_PROVIDER_URL=
NID_PROVIDER_KEY=
# Image storage. Without ImageKit, photos are stored in Postgres.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Not needed: maps use keyless Leaflet tiles. Only reported on the admin integrations card.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ── Tuning ──
# DB_POOL_MAX=5
# REQUIRE_VERIFIED_TO_VOTE=true
